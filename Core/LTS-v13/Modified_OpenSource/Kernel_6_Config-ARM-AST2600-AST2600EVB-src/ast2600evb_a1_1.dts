	phy-handle = <&ethphy3>;
	use-ncsi;
	
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_rmii4_default>;
};
#else
&mac3 {
	status = "okay";

	phy-mode = "rgmii-id";
	phy-handle = <&ethphy3>;

	pinctrl-names = "default";
