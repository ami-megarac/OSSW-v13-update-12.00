+static int fit_check_max_depth(const void *fit)
+{
+	int noffset;
+	int ndepth = 0;
+
+	for (noffset = fdt_next_node(fit, -1, &ndepth);
+	     noffset >= 0;
+	     noffset = fdt_next_node(fit, noffset, &ndepth)) {
+		/*
+		 * fdt_next_node() reports root depth as 1. Keep the same
+		 * effective nesting limit as the upstream depth-limited
+		 * recursive check by rejecting only when we exceed it.
+		 */
+		if (ndepth > FDT_MAX_DEPTH)
+			return -FDT_ERR_BADSTRUCTURE;
+	}
+
+	return noffset < 0 && noffset != -FDT_ERR_NOTFOUND ? noffset : 0;
+}
+
 /**
